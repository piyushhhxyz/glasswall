# Copy to .env and fill in. .env is gitignored; this file is not.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

S3_BUCKET=
ORIGINAL_DATA_URI=s3://your-bucket/your-export/
PII_DATA_URI=s3://your-bucket/your-export-pii/

# Largest object slice fetched per side, in bytes. Default 5 MiB.
# MAX_OBJECT_BYTES=5242880
